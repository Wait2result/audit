{
  "expo": {
    "name": "Дагестан",
    "slug": "dagestan",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dagestan",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.dagestan.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "Чтобы показать заведения и объявления рядом с вами и построить маршрут. Без доступа приложение работает — город можно выбрать вручную."
      }
    },
    "android": {
      "package": "ru.dagestan.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d2b31",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Чтобы показать заведения и объявления рядом с вами. Без доступа приложение работает — город можно выбрать вручную."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d2b31",
          "ios": {
            "backgroundColor": "#0d2b31",
            "image": "./assets/images/splash-scene.jpg",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
