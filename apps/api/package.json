{
  "name": "@dagestan/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend и API платформы «Дагестан»",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node test/e2e/user-scenarios.mjs && node test/e2e/media.mjs && node test/e2e/media-proxy.mjs && node test/e2e/two-factor.mjs && node test/e2e/listing-location.mjs && node test/e2e/listing-foundation.mjs && node test/e2e/listing-seller.mjs",
    "dev:reset-limits": "docker exec dagestan-redis sh -c \"redis-cli --scan --pattern rl:* | xargs -r redis-cli del; redis-cli --scan --pattern otp:cooldown:* | xargs -r redis-cli del\"",
    "dev:demo-place": "tsx scripts/dev-demo-place.ts",
    "dev:demo-listings": "tsx scripts/dev-demo-listings.ts",
    "db:category-images": "tsx scripts/seed-place-categories.ts",
    "db:migrate:listings-v2": "tsx scripts/migrate-listings-v2.ts",
    "db:migrate:listing-locations": "tsx scripts/migrate-listing-locations.ts",
    "dev:load-listings": "tsx scripts/dev-load-listings.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@dagestan/shared": "0.1.0",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.1",
    "fastify": "5.12.1",
    "file-type": "^22.0.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.1.0",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "pino-pretty": "^13.0.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
