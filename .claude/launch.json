{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "phone-metro",
      "url": "http://localhost:8081",
      "port": 8081
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mobile", "--", "--web"],
      "port": 8081
    },
    {
      "name": "mobile-tunnel",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mobile:tunnel"],
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3001
    },
    {
      "name": "mobile-web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--workspace",
        "@dagestan/mobile",
        "--",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    }
  ]
}
