# ─────────────────────────────────────────────────────────────────────────────
#  ШАБЛОН переменных окружения.
#
#  Как пользоваться:
#    1. Скопируйте этот файл рядом и назовите его .env
#       (Windows PowerShell:  Copy-Item .env.example .env)
#    2. Заполните значения.
#
#  Файл .env НИКОГДА не попадает в git — в нём живут настоящие пароли и ключи.
#  Значения ниже — заглушки, безопасные для локальной разработки.
# ─────────────────────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Порт, на котором работает API. Документация будет на http://localhost:3000/docs
API_PORT=3000
# Адрес API, каким его видят приложение и админка
API_PUBLIC_URL=http://localhost:3000
# Адреса, которым разрешено обращаться к API из браузера (через запятую)
CORS_ORIGINS=http://localhost:3001,http://localhost:8081,http://localhost:19006
# Проброс на Metro (сборщик JS для телефона) через тот же туннель, что и API —
# см. комментарий в .env. Пусто — выключено (обычная разработка).
MOBILE_TUNNEL_PROXY_PORT=
# Ключ ngrok (dashboard.ngrok.com → Your Authtoken) для сторожа разработки
# (scripts/dev-supervisor.js). Пусто — ngrok берёт ключ из своего ngrok.yml.
NGROK_AUTHTOKEN=

# ── Панель управления (apps/web) ────────────────────────────────────────────
# Адрес API, к которому обращается серверная часть панели.
# Панель ходит к API со своего сервера, а не из браузера пользователя.
API_URL=http://localhost:3000/api/v1

# ── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dagestan:dagestan_dev_password@localhost:5432/dagestan_dev?schema=public

# ── Redis (кеш, лимиты запросов, очереди задач) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Токены авторизации ───────────────────────────────────────────────────────
# СГЕНЕРИРУЙТЕ СВОИ значения командой:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Разные значения для access и refresh — обязательно.
JWT_ACCESS_SECRET=CHANGE_ME_dev_access_secret_min_32_chars_long_value
JWT_REFRESH_SECRET=CHANGE_ME_dev_refresh_secret_min_32_chars_long_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Шифрование чувствительных данных в базе (документы водителей и т.п.) ─────
# Ровно 32 байта в base64. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ При потере этого ключа зашифрованные данные восстановить НЕВОЗМОЖНО.
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes_key_here_aaaaaaaaaa=

# ── Файловое хранилище (S3-совместимое) ──────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_ACCESS_KEY=dagestan_dev
S3_SECRET_KEY=dagestan_dev_password
S3_BUCKET_PUBLIC=dagestan-media
S3_BUCKET_PRIVATE=dagestan-private
# Для MinIO нужно true, для настоящего S3 — обычно false
S3_FORCE_PATH_STYLE=true
# Домен, с которого отдаются публичные файлы (в production — свой CDN-домен)
S3_PUBLIC_URL=http://localhost:9000/dagestan-media

# ── SMS (коды подтверждения) ─────────────────────────────────────────────────
# В режиме console коды НЕ отправляются, а печатаются в консоль сервера.
# Так можно разрабатывать и тестировать, не тратя деньги на SMS.
# Возможные значения: console | smsc | smsru
SMS_PROVIDER=console
SMS_SENDER_NAME=DAGESTAN
SMSC_LOGIN=
SMSC_PASSWORD=
SMSRU_API_ID=

# ── Лимиты защиты (см. раздел «Защита от DDoS» в плане) ──────────────────────
# Сколько запросов в минуту разрешено с одного IP-адреса
RATE_LIMIT_GLOBAL_PER_MINUTE=120
# Минимальный интервал между двумя SMS на один номер, секунд
OTP_RESEND_COOLDOWN_SECONDS=60
# Сколько SMS максимум можно отправить на один номер за сутки
OTP_MAX_PER_PHONE_PER_DAY=5
# Сколько SMS максимум можно запросить с одного IP за час
OTP_MAX_PER_IP_PER_HOUR=10
# Сколько живёт код подтверждения, секунд
OTP_TTL_SECONDS=300
# Сколько раз можно ошибиться при вводе кода, прежде чем код сгорит
OTP_MAX_ATTEMPTS=5
# Сколько неудачных попыток входа до временной блокировки
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
# Общий потолок отправки SMS по всей системе за сутки.
# Последний рубеж защиты бюджета: даже если атака идёт с тысяч адресов
# и каждый из них укладывается в свой лимит, суммарный расход не превысит это
# число. При достижении потолка в логи попадает запись уровня ERROR.
# Оцените так: ожидаемое число регистраций в сутки, умноженное на 3.
SMS_DAILY_LIMIT=2000

# ── Мониторинг ошибок ────────────────────────────────────────────────────────
# Пусто = отключено. В production — адрес self-hosted GlitchTip/Sentry.
SENTRY_DSN=

# ── Внешние сервисы (заполняются на своих этапах) ────────────────────────────
# Open-Meteo отдаёт одинаковый API и с публичного сервиса, и с self-hosted
# инстанса — при переходе в production меняется только этот адрес. Публичный
# домен в production запрещён проверкой при старте сервера (config/env.ts) —
# см. docs/ADR/0003-погода-open-meteo.md.
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHER_CACHE_TTL_SECONDS=900
MAPS_PROVIDER=2gis
MAPS_API_KEY=

# ── Геокодирование объявлений (ADR-0010) ─────────────────────────────────────
# Подсказки адреса (Photon) и адрес по точке (Nominatim) — оба по данным
# OpenStreetMap, без ключа. Публичные серверы — только для разработки: их
# правила запрещают нагрузку приложения, и в production сервер не запустится,
# пока здесь не будет свой Photon/Nominatim или платный поставщик.
GEOCODER_SUGGEST_PROVIDER=photon
GEOCODER_REVERSE_PROVIDER=nominatim
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Публичный Nominatim требует представиться: название и контакт
GEOCODER_USER_AGENT=DagestanApp/1.0 (development)
GEOCODER_TIMEOUT_MS=6000
GEOCODER_CACHE_TTL_SECONDS=86400

# Подложка карты в приложении (apps/mobile/.env). Пусто — стандартные тайлы
# OpenStreetMap, годные только для разработки; для сборки в магазины — свой
# поставщик, например https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=…
# EXPO_PUBLIC_MAP_TILE_URL=
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=

# ── Умный поиск и локальная модель (docs/ADR/0011-умный-поиск.md) ───────────
# Без модели приложение работает как раньше: умный поиск отвечает «недоступен»,
# обычный поиск разделов не зависит от него. Установка Ollama — docs/smart-search-ollama.md
SMART_SEARCH_ENABLED=false
SMART_SEARCH_CONTEXT_TTL_SECONDS=1200
# Разбор фразы: local — словарь и правила без модели (по умолчанию), ai — языковая модель
SMART_SEARCH_PARSER=local
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
AI_TIMEOUT_MS=20000
AI_MAX_RESPONSE_CHARS=16000
AI_CONTEXT_TOKENS=8192
# Только для отладки: пишет в журнал причину отказа разбора (в production запрещён)
AI_DEBUG_LOG=false

# ── Платежи (Этап 7; включается только когда будет юрлицо и договор) ─────────
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
